# In produzione non impostare VITE_VISION_WS_URL: il client userà automaticamente
# wss://<host-della-pagina>/ws/vision, adatto a Cloudflare Tunnel e reverse proxy.
#
# Impostalo soltanto quando frontend e backend sono su host diversi in sviluppo.
# VITE_VISION_WS_URL=http://127.0.0.1:8765

# Livello diagnostico: i box RF-DETR in modalità AUTO e lo scheletro della mano
# in modalità puntamento. Serve a verificare che cosa riconoscono i modelli,
# non all'utente finale: lascialo spento.
# Si accende anche senza ricostruire la build, aggiungendo ?debug=1 all'indirizzo.
VITE_SHOW_DETECTIONS=false
